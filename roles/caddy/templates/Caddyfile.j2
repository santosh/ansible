# {{ ansible_managed }}
# Reverse proxy for the tailnet. Reachable only over Tailscale, even though
# the domains themselves are public - see caddy_bind_address.

{% for vhost in caddy_vhosts %}
{% if not loop.first %}

{% endif %}
{{ vhost.fqdn }} {
{% if caddy_bind_address %}
	bind {{ caddy_bind_address }}
{% endif %}
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	log {
		output file /var/log/caddy/access-{{ vhost.fqdn }}.log
		format console
	}

{% if vhost.sites is defined %}
{% for site in vhost.sites %}
	handle_path {{ site.path }}/* {
		reverse_proxy {{ site.upstream }} {
{% if site.host_header is defined %}
			header_up Host {{ site.host_header }}
{% endif %}
			header_up X-Forwarded-Host {host}
		}
	}

{% endfor %}
	handle {
		respond "caddy on {{ inventory_hostname }} - routes:{% for site in vhost.sites %} {{ site.path }}{% endfor %}" 200
	}
{% else %}
	reverse_proxy {{ vhost.upstream }}
{% endif %}
}
{% endfor %}
